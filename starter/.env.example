# Client (browser). PUBFLOW_PUBLIC_* and VITE_* are equivalent; Vite inlines both.
PUBFLOW_PUBLIC_FLOWLESS_URL=http://localhost:8787
PUBFLOW_PUBLIC_BRIDGE_SECRET=
PUBFLOW_PUBLIC_APP_NAME=Pubflow Native
PUBFLOW_PUBLIC_DEFAULT_THEME=system
PUBFLOW_PUBLIC_DEFAULT_LANGUAGE=en
# VITE_FLOWLESS_URL=http://localhost:8787
# VITE_BRIDGE_SECRET=

# Server only — normal process env. Never VITE_ or PUBFLOW_PUBLIC_. Pages cannot read these.
FLOWLESS_URL=http://localhost:8787
BRIDGE_VALIDATION_SECRET=
DATABASE_URL=
PORT=3000
