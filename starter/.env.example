# Client (browser) — same pattern as create-flowfull-client (VITE_API_BASE_URL / VITE_BRIDGE_SECRET).
# PUBFLOW_PUBLIC_* and VITE_* are equivalent; Vite inlines both. Flowless is the source of truth.
PUBFLOW_PUBLIC_FLOWLESS_URL=http://localhost:8787
PUBFLOW_PUBLIC_BRIDGE_SECRET=
PUBFLOW_PUBLIC_APP_NAME=Pubflow Native
PUBFLOW_PUBLIC_DEFAULT_THEME=system
PUBFLOW_PUBLIC_DEFAULT_LANGUAGE=en
# VITE_FLOWLESS_URL=http://localhost:8787
# VITE_BRIDGE_SECRET=

# Server — same Flowless URL and Bridge string, unprefixed so Vite never mixes them with DATABASE_URL.
# requireAuth() POSTs /auth/bridge/validate; Flowless decides if the session is valid.
FLOWLESS_URL=http://localhost:8787
BRIDGE_SECRET=
# BRIDGE_VALIDATION_SECRET=   # alias; same value as BRIDGE_SECRET / PUBFLOW_PUBLIC_BRIDGE_SECRET

# Secret — never VITE_ or PUBFLOW_PUBLIC_. Pages cannot read this.
DATABASE_URL=
PORT=3000
