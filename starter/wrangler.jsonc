{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pubflow-native",
  "main": "dist/server/worker.js",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
