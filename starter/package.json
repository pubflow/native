{
  "name": "pubflow-native-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr",
    "start": "node dist/server/node.js",
    "start:bun": "bun dist/server/bun.js",
    "dev:cf": "vite build && vite build --ssr && wrangler dev",
    "deploy:cf": "vite build && vite build --ssr && wrangler deploy",
    "preview:cf": "vite build && vite build --ssr && wrangler dev --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pubflow/core": "0.5.0",
    "@pubflow/native": "^0.1.5",
    "@pubflow/react": "0.5.0",
    "@tanstack/react-router": "^1.131.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.9.0",
    "i18next": "26.3.1",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "17.0.8",
    "shadcn": "^3.6.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "wrangler": "^4.20.0"
  }
}
