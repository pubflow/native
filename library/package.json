{
  "name": "@pubflow/native",
  "version": "0.1.3",
  "description": "Full-stack TypeScript framework: React pages and Hono APIs in one process. Universal — not locked to Pubflow apps.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubflow/native.git",
    "directory": "library"
  },
  "homepage": "https://github.com/pubflow/native",
  "bugs": {
    "url": "https://github.com/pubflow/native/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "prepublishOnly": "bun test src && tsc --noEmit && tsup"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./pages": {
      "types": "./src/pages.ts",
      "import": "./dist/pages.js",
      "default": "./dist/pages.js"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./actions": {
      "types": "./src/actions.ts",
      "import": "./dist/actions.js",
      "default": "./dist/actions.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    }
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.120.0",
    "hono": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": ">=6.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@vitejs/plugin-react": "^5.0.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.131.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0"
  }
}
