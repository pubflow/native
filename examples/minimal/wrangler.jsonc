{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pubflow-native-minimal",
  "main": "dist/server/worker.js",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  // Postgres/MySQL on Workers: create Hyperdrive (dashboard or wrangler), then paste the id:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id>" }],
  "alias": {
    "redis": "./optional-node-stub.js",
    "ioredis": "./optional-node-stub.js",
    "nodemailer": "./optional-node-stub.js"
  }
}
