{
  "name": "pubflow-native-custom-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr",
    "start": "node dist/server/node.js",
    "start:bun": "bun dist/server/bun.js",
    "dev:cf": "vite build && vite build --ssr && wrangler dev",
    "deploy:cf": "vite build && vite build --ssr && wrangler deploy",
    "preview:cf": "vite build && vite build --ssr && wrangler dev --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pubflow/native": "0.1.4",
    "@tanstack/react-router": "^1.131.0",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "wrangler": "^4.20.0"
  }
}
